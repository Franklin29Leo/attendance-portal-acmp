# Copiar a config/app.env y completar. config/app.env es SECRETO (no subir a git).

# ---- PostgreSQL (contenedor db) ----
POSTGRES_USER=asistencia
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
POSTGRES_DB=asistencia
# Debe usar la misma clave de arriba; el host es "db" (nombre del servicio)
DATABASE_URL=postgresql+psycopg://asistencia:CAMBIAR_POR_UNA_CLAVE_SEGURA@db:5432/asistencia

# ---- ERP IGEA ----
ERP_BASE_URL=https://app.igeaerp.com
# Áreas separadas por coma, tal como las usa el ERP. Vacío = area="" (todas)
ERP_AREAS=SEDE CHORRILLOS
ERP_TIMEOUT=30
# Cookie PHPSESSID del ERP. Se relee en cada consulta: al vencer, pega la nueva (sin reiniciar).
ERP_PHPSESSID=

# ---- Fotos y carga automática ----
FOTO_BASE_URL=https://app.igeaerp.com
SYNC_ACTIVO=true
SYNC_HORAS=08:30,09:30,13:00,18:30
TZ_LOCAL=America/Lima

# El frontend se sirve en el mismo puerto que la API, así que no necesita CORS
CORS_ORIGINS=http://localhost:8001

# Conexión a PostgreSQL
DATABASE_URL=postgresql+psycopg://asistencia:asistencia@localhost:5432/asistencia

# ERP IGEA: consulta GET source_frmAsistenciaPro.php?op=listar
ERP_BASE_URL=https://app.igeaerp.com
# Áreas a consultar, separadas por coma (tal como las usa el ERP). Vacío = area="" (todas las que permita la sesión)
ERP_AREAS=SEDE CHORRILLOS
ERP_TIMEOUT=30
# Cookie de sesión del ERP (valor de PHPSESSID). SECRETO: no compartir ni subir a repositorios.
# Se relee en cada consulta: al vencer, pega la nueva y no hace falta reiniciar.
ERP_PHPSESSID=

# Base para mostrar las fotos (foto_entrada viene como ruta relativa: /img/user/...)
FOTO_BASE_URL=https://servidor.ejemplo

# Carga automática diaria: horas (HH:MM, separadas por coma) en que se consulta el día actual
SYNC_ACTIVO=true
SYNC_HORAS=08:30,09:30,13:00,18:30
TZ_LOCAL=America/Lima

# Orígenes permitidos para el frontend
CORS_ORIGINS=http://localhost:5173

# ---- Inicio de sesión ----
# Clave para firmar las sesiones (obligatoria en producción). Generar con:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESION_HORAS=12
# true solo si la web se sirve por HTTPS
COOKIE_SECURE=false
# Primer administrador (se crea solo si no existe ningún usuario). Vacío = contraseña temporal en el log
ADMIN_USUARIO=admin
ADMIN_PASSWORD_INICIAL=
# Sedes que se crean la primera vez: NOMBRE=ÁREA EXACTA DEL ERP (después se administran en la web)
SEDES_INICIALES=CHORRILLOS=SEDE CHORRILLOS,TIZA=SEDE TIZA
